---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url, dateLabel } from '../site';
const posts = (await getCollection('posts', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const tags = [...new Set(posts.flatMap(p => p.data.tags))];
---
<Layout>
  <section class="hero">
    <div><p class="eyebrow"><span class="status-dot"></span> LILIKA’S NOTEBOOK</p><h1>于长夜中，<br />拾起星光<span class="green">。</span></h1><p class="hero-description">欢迎来到lilika的学习领地。<br />把知识写成手记，让每一次探索都有迹可循。</p><a class="text-link" href="#notes">翻开夜之手记 <span>↓</span></a></div>
    <div class="night-emblem" aria-hidden="true"><div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div><svg class="moon-sigil" viewBox="0 0 320 320" fill="none"><path d="M214 52a111 111 0 1 0 49 166A99 99 0 0 1 214 52Z" fill="url(#moon)"/><defs><linearGradient id="moon" x1="65" y1="50" x2="240" y2="265" gradientUnits="userSpaceOnUse"><stop stop-color="#e2d4f7"/><stop offset="1" stop-color="#a384cf"/></linearGradient></defs><path d="m112 141 25 19 23-42 23 42 25-19-12 65h-72l-12-65Z" fill="#ffffff" stroke="#8d68b5" stroke-width="2" stroke-linejoin="round"/><path d="M128 216h64M160 228v22m-8-10h16" stroke="#8d68b5" stroke-width="2" stroke-linecap="round"/><path d="m238 82 3 10 10 3-10 3-3 10-3-10-10-3 10-3 3-10ZM77 222l2 7 7 2-7 2-2 7-2-7-7-2 7-2 2-7Z" fill="#a384cf"/><circle cx="105" cy="67" r="2" fill="#8d68b5"/><circle cx="253" cy="218" r="2" fill="#8d68b5"/></svg><div class="emblem-caption">lilika<span>THE NIGHT IS A PLACE TO BEGIN</span></div></div>
  </section>
  <section id="notes" class="notes-section"><div class="section-heading"><div><p class="eyebrow">THE NOTEBOOK</p><h2>最近的记录 <sup>{String(posts.length).padStart(2,'0')}</sup></h2></div><span class="muted">每一篇，都是一次整理。</span></div>
    <div class="filters"><div class="tag-list" role="group" aria-label="按标签筛选"><button class="chip selected" data-tag="" aria-pressed="true">全部</button>{tags.map(tag => <button class="chip" data-tag={tag} aria-pressed="false">{tag}</button>)}</div><label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" aria-label="搜索笔记" placeholder="搜索笔记…" /></label></div>
    <div class="post-list">{posts.map((post, i) => <article class="post-row" data-tags={JSON.stringify(post.data.tags)} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}><span class="post-number">{String(i+1).padStart(2,'0')}</span><div><div class="post-meta"><time datetime={dateLabel(post.data.date)}>{dateLabel(post.data.date)}</time><span> / </span>{post.data.tags.map(tag => <span>{tag}</span>)}</div><h3><a href={url(`posts/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></div><a class="post-arrow" href={url(`posts/${post.id}/`)} aria-label={`阅读：${post.data.title}`}>↗</a></article>)}</div>
    <p id="empty" class="empty" hidden>还没有匹配的笔记，试试其他关键词。</p><p id="result-count" class="sr-only" aria-live="polite"></p>
  </section>
  <aside class="closing"><span>↳</span><p>不急着抵达，<br /><strong>先把走过的路记下来。</strong></p><a class="text-link" href={url('about/')}>关于这本手记 ↗</a></aside>
</Layout>
<script>
  let selected = '';
  const input = document.querySelector<HTMLInputElement>('#search')!;
  const rows = [...document.querySelectorAll<HTMLElement>('.post-row')];
  function filter() {
    let count = 0;
    rows.forEach(row => { row.hidden = !( (!selected || JSON.parse(row.dataset.tags!).includes(selected)) && row.dataset.search!.includes(input.value.trim().toLowerCase())); if (!row.hidden) count++; });
    document.querySelector<HTMLElement>('#empty')!.hidden = count > 0;
    document.querySelector('#result-count')!.textContent = `找到 ${count} 篇笔记`;
  }
  document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach(button => button.addEventListener('click', () => {
    selected = button.dataset.tag!;
    document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach(b => { b.classList.toggle('selected', b === button); b.setAttribute('aria-pressed', String(b === button)); }); filter();
  }));
  input.addEventListener('input', filter);
</script>
